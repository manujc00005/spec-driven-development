# Local Claude Code settings — machine-specific paths and session command history, never publish
.claude/settings.local.json

# Graphify output and other generated artifacts
graphify-out/
.tmp/

# Secrets
.env
.env.*

# Logs
*.log

# OS/editor noise
.DS_Store
Thumbs.db

.idea/
*.iml

# Python bytecode (the runner/ package, spec 040)
__pycache__/
*.py[cod]

# Per-run machine log written by runner/ into the feature folder (spec 040).
# ORCHESTRATION.md is the durable, human-readable record and IS committed;
# run.jsonl is the transcript of one invocation and is not.
specs/features/*/run.jsonl
